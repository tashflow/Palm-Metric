{
  "entities": {
    "Billboard": {
      "title": "Billboard",
      "description": "Promotional hero billboard, offer banner, or looping video managed by Palm Metric Admin.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "titleAr": { "type": "string", "maxLength": 200 },
        "titleEn": { "type": "string", "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 400 },
        "subtitleAr": { "type": "string", "maxLength": 400 },
        "subtitleEn": { "type": "string", "maxLength": 400 },
        "mediaUrl": { "type": "string", "maxLength": 700000 },
        "imageUrl": { "type": "string", "maxLength": 700000 },
        "videoUrl": { "type": "string", "maxLength": 700000 },
        "storagePath": { "type": "string", "maxLength": 512 },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "isActive": { "type": "boolean" },
        "active": { "type": "boolean" },
        "order": { "type": "number" },
        "category": { "type": "string", "maxLength": 80 },
        "ctaLabel": { "type": "string", "maxLength": 60 },
        "badge": { "type": "string", "maxLength": 60 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Specialty coffee, matcha, or pastry product managed by Palm Metric Admin.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 140 },
        "nameAr": { "type": "string", "maxLength": 140 },
        "nameEn": { "type": "string", "maxLength": 140 },
        "description": { "type": "string", "maxLength": 500 },
        "descriptionAr": { "type": "string", "maxLength": 500 },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "isOffer": { "type": "boolean" },
        "offerLabel": { "type": "string", "maxLength": 60 },
        "category": { "type": "string", "maxLength": 80 },
        "categoryAr": { "type": "string", "maxLength": 80 },
        "imageUrl": { "type": "string", "maxLength": 700000 },
        "storagePath": { "type": "string", "maxLength": 512 },
        "inStock": { "type": "boolean" },
        "stockQuantity": { "type": "number" },
        "stockCount": { "type": "number" },
        "supportsTemp": { "type": "boolean" },
        "allowTemperature": { "type": "boolean" },
        "allowMilkOption": { "type": "boolean" },
        "coconutMilkPrice": { "type": "number" },
        "origin": { "type": "string", "maxLength": 80 },
        "originAr": { "type": "string", "maxLength": 80 },
        "region": { "type": "string", "maxLength": 80 },
        "regionAr": { "type": "string", "maxLength": 80 },
        "processingMethod": { "type": "string", "maxLength": 80 },
        "processingMethodAr": { "type": "string", "maxLength": 80 },
        "roastLevel": { "type": "string", "maxLength": 60 },
        "altitude": { "type": "string", "maxLength": 60 },
        "variety": { "type": "string", "maxLength": 80 },
        "tastingNotes": { "type": "array" },
        "tastingNotesAr": { "type": "array" },
        "brewMethods": { "type": "array" },
        "producer": { "type": "string", "maxLength": 120 },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Category": {
      "title": "Category",
      "description": "Menu category managed by Palm Metric Admin.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 80 },
        "nameAr": { "type": "string", "maxLength": 80 },
        "nameEn": { "type": "string", "maxLength": 80 },
        "order": { "type": "number" },
        "active": { "type": "boolean" }
      }
    },
    "CoffeeOptionsSettings": {
      "title": "CoffeeOptionsSettings",
      "description": "Global fallback milk and hot/cold options stored at settings/coffeeOptions.",
      "type": "object",
      "properties": {
        "milkSelectionEnabled": { "type": "boolean" },
        "coconutMilkExtraPrice": { "type": "number" },
        "hotColdSelectionEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Order": {
      "title": "Order",
      "description": "Canonical Pickup order created either by Stage 04E Cloud Function or Stage 04L Admin Approval Promotion and isolated by customerUid.",
      "type": "object",
      "properties": {
        "orderNumber": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "customerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "customerContact": { "type": "string", "minLength": 4, "maxLength": 80 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discountTotal": { "type": "number" },
        "taxTotal": { "type": "number" },
        "totalBill": { "type": "number" },
        "currency": { "type": "string", "enum": ["SAR"] },
        "orderType": { "type": "string", "enum": ["pickup"] },
        "status": {
          "type": "string",
          "enum": ["Pending", "Preparing", "Ready", "Completed", "Cancelled"]
        },
        "notes": { "type": "string", "maxLength": 240 },
        "sourceApp": { "type": "string", "maxLength": 64 },
        "lang": { "type": "string", "enum": ["ar", "en"] },
        "idempotencyKey": { "type": "string", "maxLength": 128 },
        "pricingVersion": { "type": "number" },
        "sourceRequestId": { "type": "string", "maxLength": 128 },
        "paymentMethod": { "type": "string", "enum": ["pay_on_pickup"] },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "paid"] },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "approvedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderNumber", "customerUid", "customerName", "customerContact", "items", "totalBill", "status", "createdAt", "updatedAt"]
    },
    "OrderRequest": {
      "title": "OrderRequest",
      "description": "Spark-compatible customer pickup order request written to /orderRequests/{requestId} with zero client prices. Reviewed, verified, and promoted to /orders by Palm Metric Admin in Stage 04L.",
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "customerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "customerContact": { "type": "string", "minLength": 4, "maxLength": 80 },
        "orderType": { "type": "string", "enum": ["pickup"] },
        "currency": { "type": "string", "enum": ["SAR"] },
        "lang": { "type": "string", "enum": ["ar", "en"] },
        "orderNote": { "type": "string", "maxLength": 220 },
        "items": { "type": "array" },
        "status": {
          "type": "string",
          "enum": ["pending_review", "reviewing", "verified", "order_created", "approved", "rejected", "cancelled"]
        },
        "requestSource": { "type": "string", "enum": ["customer-app-spark"] },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "verifiedBy": { "type": "string", "maxLength": 128 },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "verifiedTotalSar": { "type": "number" },
        "verifiedPricing": { "type": "object" },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "approvedAt": { "type": "string", "format": "date-time" },
        "approvedOrderId": { "type": "string", "maxLength": 128 },
        "approvedOrderNumber": { "type": "string", "maxLength": 24 },
        "rejectedBy": { "type": "string", "maxLength": 128 },
        "rejectedAt": { "type": "string", "format": "date-time" },
        "rejectionReason": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "requestId",
        "customerUid",
        "customerName",
        "customerContact",
        "orderType",
        "currency",
        "items",
        "status",
        "requestSource",
        "createdAt",
        "updatedAt"
      ]
    },
    "OrderRequestAuditLog": {
      "title": "OrderRequestAuditLog",
      "description": "Immutable administrative audit trail for Stage 04L order request review, price verification, rejection, and promotion actions.",
      "type": "object",
      "properties": {
        "requestId": { "type": "string", "maxLength": 128 },
        "action": {
          "type": "string",
          "enum": [
            "start_review",
            "verify_request",
            "price_verification",
            "approve_and_promote",
            "reject_request",
            "order_promotion",
            "duplicate_approval_blocked",
            "verification_blocked"
          ]
        },
        "adminUid": { "type": "string", "maxLength": 128 },
        "adminEmail": { "type": "string", "maxLength": 200 },
        "previousStatus": { "type": "string", "maxLength": 40 },
        "newStatus": { "type": "string", "maxLength": 40 },
        "approvedOrderId": { "type": "string", "maxLength": 128 },
        "approvedOrderNumber": { "type": "string", "maxLength": 24 },
        "verifiedTotalSar": { "type": "number" },
        "reason": { "type": "string", "maxLength": 300 },
        "details": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["requestId", "action", "adminUid", "createdAt"]
    },
    "IdempotencyKey": {
      "title": "IdempotencyKey",
      "description": "Server-only transactional idempotency record preventing duplicate orders on retries.",
      "type": "object",
      "properties": {
        "customerUid": { "type": "string", "maxLength": 128 },
        "idempotencyKey": { "type": "string", "maxLength": 128 },
        "requestDigest": { "type": "string", "maxLength": 128 },
        "orderId": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 24 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerUid", "idempotencyKey", "requestDigest", "orderId", "orderNumber", "createdAt"]
    },
    "ProductCustomization": {
      "title": "ProductCustomization",
      "description": "Admin-controlled per-product customization groups, options, selection rules, and SAR add-on prices.",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "maxLength": 128 },
        "enabled": { "type": "boolean" },
        "groups": { "type": "array" },
        "schemaVersion": { "type": "number" },
        "allowSpecialInstructions": { "type": "boolean" },
        "updatedBy": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "enabled", "groups", "schemaVersion"]
    },
    "AppReport": {
      "title": "AppReport",
      "description": "Customer feedback or issue report sent to Palm Metric Admin.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["order", "feedback", "customer_signup", "issue"] },
        "title": { "type": "string", "maxLength": 160 },
        "message": { "type": "string", "maxLength": 1000 },
        "customerName": { "type": "string", "maxLength": 80 },
        "customerPhone": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["New", "Reviewed", "Resolved"] },
        "sourceApp": { "type": "string", "maxLength": 60 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "title", "status", "createdAt"]
    },
    "FcmToken": {
      "title": "FcmToken",
      "description": "Web push notification registration token owned by a customer session UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "token": { "type": "string", "maxLength": 4096 },
        "updatedAt": { "type": "string" },
        "userAgent": { "type": "string", "maxLength": 512 }
      },
      "required": ["uid", "token", "updatedAt"]
    },
    "OrderNumberClaim": {
      "title": "OrderNumberClaim",
      "description": "Immutable uniqueness reservation claiming an official PM-XXXXXX orderNumber for a promoted /orders document.",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string", "minLength": 3, "maxLength": 24 },
        "orderId": { "type": "string", "maxLength": 128 },
        "requestId": { "type": "string", "maxLength": 128 },
        "customerUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderNumber", "orderId", "requestId", "customerUid", "createdAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Verified store administrator record.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "role": { "type": "string", "enum": ["admin"] }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/billboards/{billboardId}": {
      "schema": { "$ref": "#/entities/Billboard" },
      "description": "Active promotional hero banners and videos controlled by Palm Metric Admin."
    },
    "/menu/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Primary menu collection controlled by Palm Metric Admin."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Menu categories managed by Palm Metric Admin."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/CoffeeOptionsSettings" },
      "description": "Global coffeeOptions and store configuration controlled by Palm Metric Admin."
    },
    "/productCustomizations/{productId}": {
      "schema": { "$ref": "#/entities/ProductCustomization" },
      "description": "Per-product customization groups and options managed strictly by verified admins."
    },
    "/orderRequests/{requestId}": {
      "schema": { "$ref": "#/entities/OrderRequest" },
      "description": "Spark-compatible customer pickup order requests awaiting Admin price verification and approval."
    },
    "/orderRequestAuditLogs/{auditId}": {
      "schema": { "$ref": "#/entities/OrderRequestAuditLog" },
      "description": "Immutable administrative audit logs recording Stage 04L order request reviews, verifications, promotions, and rejections."
    },
    "/orderNumbers/{orderNumber}": {
      "schema": { "$ref": "#/entities/OrderNumberClaim" },
      "description": "Immutable orderNumber uniqueness claim index preventing PM-XXXXXX collisions during Spark atomic promotions."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Canonical Pickup orders created by Cloud Function Admin SDK or Admin Dashboard (Stage 04L) and isolated by customerUid."
    },
    "/idempotencyKeys/{keyId}": {
      "schema": { "$ref": "#/entities/IdempotencyKey" },
      "description": "Server-only transactional idempotency records (no client read or write access)."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/AppReport" },
      "description": "Customer feedback and issue reports sent to Palm Metric Admin."
    },
    "/fcmTokens/{tokenId}": {
      "schema": { "$ref": "#/entities/FcmToken" },
      "description": "Push notification registration tokens scoped to owner UID."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Verified store administrator identities."
    }
  }
}
